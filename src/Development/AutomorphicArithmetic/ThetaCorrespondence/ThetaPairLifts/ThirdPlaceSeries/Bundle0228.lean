    have hc := (H.above P AI hT w A h O Bw hj).crys σ hσ ((_root_.GlobalTheory.CuspRep.ParLaws.reciprocity_unramified_iff_spherical (_root_.GlobalTheory.CuspRep.ParLawsT.isRecT_locRecT hL h) (ParLaws.toRep σ)).1 (by
