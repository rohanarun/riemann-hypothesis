  have hV : IsOpen ((Units.val : kˣ → k) '' (χ.ker : Set kˣ)) := hval.isOpenMap _ hχ
  have hd : Continuous fun g : GL (Fin (r + t)) k =>
      (g.val.submatrix (Fin.natAdd r) (Fin.natAdd r)).det :=
    (Units.continuous_val.matrix_submatrix _ _).matrix_det
