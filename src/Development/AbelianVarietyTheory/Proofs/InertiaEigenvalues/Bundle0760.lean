  intro L _ _ _ n F π U hD v w hO
  refine ⟨_root_.GlobalTheory.UnramDict.isUnramU_of_sphAt L n F π U hD v w hO, fun s ϖ q hs hU => ?_⟩
  obtain ⟨hun, hns, hq⟩ := _root_.GlobalTheory.InertOfUnramInv.inert_of_isUnramInv L v w hO s ϖ q hs hU
  refine ⟨_root_.GlobalTheory.InertDatumGiven.exists_inertDatum_of L n v w hO hun hns s ϖ hs (hq ▸ hU), fun Dv α hσ hϖ hsat => ?_⟩
  have hsph : π.SphAt v := by
    obtain ⟨f, hf, hf0, U0, hU0, hU0', -⟩ := hsat
    exact ⟨f, hf, hf0, fun κ hκ ht => hU0 κ ((hU0' κ ht).2 hκ)⟩
  obtain ⟨α0, h0⟩ := _root_.GlobalTheory.InertSatakeGiven.exists_hasSatAt L n U hD.1 w hun hns s ϖ q hs hU (_root_.GlobalTheory.UnramDict.isUnramU_of_sphAt L n F π U hD v w hO hsph)
  subst hσ hϖ hq
  have heq := _root_.GlobalTheory.InertHeckeCmp.satU_eq L n F π U hD v w hO Dv α hsat α0 h0
  have hnz := _root_.GlobalTheory.SatNonzero.satU_ne_zero (w.adicCompletion L) Dv.ϖ Dv.σw _ n hU α α0 heq
  refine ⟨fun i => Units.mk0 (α i) (hnz i), fun i => rfl, ?_⟩
  obtain ⟨b, hb, hb2, p, hp, σ, hc, hs1, hs2⟩ := h0
  refine ⟨b, hb, hb2, p, hp, σ, hc, hs1, fun x hx hx0 => ?_⟩
  obtain ⟨a1, a2, a3⟩ := hs2 x hx hx0
  refine ⟨a1, a2, fun h hh => ?_⟩
  rw [a3 h hh, ← heq h hh]
