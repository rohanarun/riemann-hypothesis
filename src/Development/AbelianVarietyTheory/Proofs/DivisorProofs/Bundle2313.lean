    obtain ⟨hm', -, hq', ht'⟩ := hb'
    have := hm e
    have := hm' e
    obtain ⟨t, htt, hti⟩ := ht e
    obtain ⟨t', htt', hti'⟩ := ht' e
    obtain rfl := GlobalTheory.LinearUnifCheck.torusEndOf_unique htt htt'
    exact eq_of_q_of_i (U.gt e) (b e) (b' e) _ (hq e) (hq' e) (hti.trans hti'.symm)
