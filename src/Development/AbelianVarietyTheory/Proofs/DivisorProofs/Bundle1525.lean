      intro τ
      rw [← _root_.GlobalTheory.Nef.evAt_calculus.1 p.O E C φ b _ hb'' (top_le_comp_preimage _ _ hb''), evAt_congr hbx _ hxE'',
        ← _root_.GlobalTheory.Nef.evAt_calculus.2.2.1 E C xE _ _ hsub hxE'' hxs]
