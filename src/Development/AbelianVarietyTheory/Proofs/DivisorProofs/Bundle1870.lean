  symm
  rw [Point.eq_toA_iff, toG_goodPoint, Over.comp_left, Category.assoc, h2]
  exact (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ (homO hv ε j o o' f).left) h1).trans (Category.assoc _ _ _))

