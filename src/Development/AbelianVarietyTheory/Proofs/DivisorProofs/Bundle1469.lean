  obtain ⟨β, hβ⟩ := hr
  let φ : X → PowerSeries Ω := fun a =>
    (Scheme.ΓSpecIso (CommRingCat.of (PowerSeries Ω))).hom.hom (ξ.appTop.hom (Rosenlicht.chi X a))
