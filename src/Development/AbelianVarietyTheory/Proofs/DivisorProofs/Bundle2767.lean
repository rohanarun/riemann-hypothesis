theorem exists_pos_mul_lt_of_finite {ι : Type*} {T : Set ι} (hT : T.Finite) (A O : ι → ℚ)
    (hA : ∀ t ∈ T, 0 < A t) : ∃ c : ℚ, 0 < c ∧ ∀ t ∈ T, c * O t < A t := by
  have h : ∀ᶠ c in nhdsWithin (0 : ℚ) (Set.Ioi 0), ∀ t ∈ T, c * O t < A t :=
