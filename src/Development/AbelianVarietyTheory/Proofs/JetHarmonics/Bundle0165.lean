  have Hy : ∀ o, (Y.rawSelf (p o)).Hyps V := fun o =>
    { charZero := inferInstance
      algClosed := Y.algClosed
      l_odd := Y.l_odd
      k_unit := Y.k_unit
      cartH := hCart C V (𝓞 E) _ Y 2 _ (p o)
      rank := (hrk hr o).1
      axes := hAx C V (𝓞 E) _ Y 2 _ (p o)
      G0 := hG0 C V (𝓞 E) _ Y 2 _ (p o) _
      CEq := hC C V (𝓞 E) _ Y 2 _ (p o) (hrk hr o).1 _
      R1 := hR1 C V (𝓞 E) _ Y 2 _ (p o) (hrk hr o).1 _
        (_root_.GlobalTheory.RowAtSelf.rowCondition_two_selfConjugate_of_nonDegenerate C V (𝓞 E) _ Y 2 _ (p o) hndg _)
      R2 := _root_.GlobalTheory.RowAtSelf.rowCondition_two_selfConjugate_of_nonDegenerate C V (𝓞 E) _ Y 2 _ (p o) hndg _
      CH := _root_.GlobalTheory.CharSquare.chSt_rawSelf hUp E H Dw lv Xo c hstar T io y C3 C V ι hι k Y hY halg Orb lab ha hr p hp o _ }
  have hfl := fun o => _root_.GlobalTheory.flag_of_numbering C V 2 (fun _ => ZMod 2) (fun _ s => Dw.mult (lab.tau o s)) tyShift
    (JJ fun _ => lab.II Dw o) ((Y.rawSelf (p o)).rowData (Hy o)) (by
      intro g x
      show (if g = 0 then (p o).ty0 x else (p o).ty0 x + (p o).hd) = _
      rw [hp.ty0, hp.hd]
      unfold tyShift
      split_ifs <;> rfl)
  have hrkF : ∀ o s, ((Y.rawSelf (p o)).rowData (Hy o)).rkF 0 s = Dw.mult (lab.tau o s) :=
    fun o s => (hfl o).1 0 s
  choose F hF using fun o => (hfl o).2
